# Server-only credentials. Copy to .env.local; never add real values to Git.
# Run npm run setup:env to generate JWT_SECRET without printing it.
JWT_SECRET=replace_with_a_generated_private_secret
OPEN_WEATHER_API_KEY=your_openweather_key
# Optional overrides for local development:
# NODE_ENV=development
# PORT=3001
# MONGODB_URI=mongodb://127.0.0.1:27017/wtwr_db
